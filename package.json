{
  "name": "boundarylab-auth-rbac",
  "version": "1.0.0",
  "private": true,
  "description": "Dependency-free Node.js authentication and server-side RBAC security lab",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "seed:admin": "node --env-file=.env src/seed-admin.js",
    "inspect:hashes": "node --env-file=.env src/inspect-hashes.js",
    "test": "node scripts/run-qa.mjs",
    "test:raw": "node --test test/*.test.js"
  },
  "license": "MIT"
}
